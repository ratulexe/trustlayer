# TrustLayer Environment Configuration Example
PORT=3000

# Caution-tier cool-down in seconds (default 900 = 15 minutes). Use ~20 for live demos.
# Set it as a real environment variable (shell or Render dashboard); server.js does not read .env for it.
CAUTION_COOLDOWN_SECONDS=900

# Google Gemini API Key (Optional for heuristic mode; required for live AI reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Firestore Configuration (Optional for mock in-memory fallback)
FIREBASE_PROJECT_ID=trustlayer-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@trustlayer-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n"

# Google sign-in (Firebase Auth, browser side). From Firebase console → Project settings →
# Your apps → Web app config. These are public identifiers, not secrets, but keep them out of code.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
